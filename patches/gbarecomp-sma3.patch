diff --git a/tests/armv4t/tail_dispatch_test.cpp b/tests/armv4t/tail_dispatch_test.cpp
index 4d6835b..e64a61c 100644
--- a/tests/armv4t/tail_dispatch_test.cpp
+++ b/tests/armv4t/tail_dispatch_test.cpp
@@ -128,6 +128,38 @@ void test_swi_return_ledger() {
           "empty ledger leaves an SVC return alone");
     runtime_fp_reset();
 }
+// Model a handler that exception-returns past pending generated BL hints.
+// The instruction hook replaces only this unit fixture, never game execution.
+int irq_fixture_level = 0;
+int irq_fixture(uint32_t pc, int) {
+    if (pc != 0x18u) return 0;
+    ++irq_fixture_level;
+    const uint32_t interrupted = g_cpu.R[14] - 4u;
+    runtime_call_push_return(0x08004000u);
+    if (irq_fixture_level == 1) {
+        const auto depth = runtime_call_stack_depth();
+        runtime_irq(0x08005000u);
+        check(runtime_call_stack_depth() == depth,
+              "nested IRQ removes only its own pending returns");
+    }
+    runtime_call_push_return(0x08004004u);
+    runtime_exception_return(interrupted);
+    --irq_fixture_level;
+    return 1;
+}
+void test_irq_return_hints() {
+    reset(false);
+    runtime_call_push_return(0x08006000u);
+    g_runtime_force_interp_hook = irq_fixture;
+    for (unsigned i=0; i<1100; ++i) {
+        runtime_irq(0x08007000u);
+        check(runtime_call_stack_depth() == 1u,
+              "completed IRQ does not leak return hints across frames");
+        check(runtime_call_stack_data()[0] == 0x08006000u,
+              "IRQ preserves interrupted mainline return");
+    }
+    g_runtime_force_interp_hook = nullptr;
+}
